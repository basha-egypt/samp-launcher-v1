<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/bg_red" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#95060310" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#A0080414"
                android:centerColor="#55200E38"
                android:endColor="#BB060310" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3B000000"
                android:centerColor="#00000000"
                android:endColor="#C2040210" />
        </shape>
    </item>
</layer-list>
