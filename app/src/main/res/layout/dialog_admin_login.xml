<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ai_server_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_badge_gold"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="ADMIN"
            android:textColor="@color/launcher_accent_gold_bright"
            android:textSize="8sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_black"
            android:text="دخول الأدمن"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/admin_user_input"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/launcher_field_surface_dark"
            android:fontFamily="@font/montserrat_bold"
            android:hint="اسم المستخدم"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="text"
            android:layoutDirection="ltr"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textColorHint="@color/launcher_text_muted"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/admin_pass_input"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/launcher_field_surface_dark"
            android:fontFamily="@font/montserrat_bold"
            android:hint="كلمة المرور"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textPassword"
            android:layoutDirection="ltr"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textColorHint="@color/launcher_text_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/admin_cancel"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/home_action_text_button"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:text="إلغاء"
                android:textColor="@android:color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/admin_login"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/home_server_select_button"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:text="دخول"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
