<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_overlay" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="92dp"
            android:paddingEnd="30dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_news_badge"
                        android:fontFamily="@font/montserrat_bold"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="ARAB ISLAND RP"
                        android:textColor="@color/launcher_accent_gold_bright"
                        android:textSize="8.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="@font/montserrat_black"
                        android:text="أهلاً بك في الجزيرة"
                        android:textColor="@android:color/white"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="حياة واقعية عربية بكل تفاصيلها. اكتب اسمك الواقعي وانطلق."
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/ai_status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/home_readiness_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/server_status_dot_online" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_readiness_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="اللانشر جاهز"
                            android:textColor="@android:color/white"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/home_readiness_body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="جاري التحقق..."
                            android:textColor="@color/launcher_text_muted"
                            android:textSize="7.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- Server card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/ai_server_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="السيرفر"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/launcher_badge_gold"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="ROLEPLAY"
                            android:textColor="@color/launcher_accent_gold_bright"
                            android:textSize="7.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/selected_server_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/montserrat_black"
                        android:maxLines="1"
                        android:text="عربي 1"
                        android:textColor="@android:color/white"
                        android:textSize="26sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/ai_gold_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/ai_status_pill"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <View
                                android:id="@+id/home_status_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/server_status_dot_loading" />

                            <TextView
                                android:id="@+id/home_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="جاري الفحص"
                                android:textColor="@android:color/white"
                                android:textSize="8.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/ai_status_pill"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_people" />

                            <TextView
                                android:id="@+id/home_players_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="-- / --"
                                android:textColor="@android:color/white"
                                android:textSize="8.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/ai_status_pill"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_ping" />

                            <TextView
                                android:id="@+id/home_ping_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="-- ms"
                                android:textColor="@android:color/white"
                                android:textSize="8.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Hidden for players; shown only in admin mode from code -->
                    <TextView
                        android:id="@+id/selected_server_address"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/launcher_field_surface_dark"
                        android:fontFamily="@font/montserrat_medium"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text=""
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="9sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/selected_server_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:text="السيرفر جاهز لاستقبالك."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="8.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/play_button"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1.4"
                            android:background="@drawable/home_play_button"
                            android:fontFamily="@font/montserrat_black"
                            android:letterSpacing="0"
                            android:text="العب الآن"
                            android:textAllCaps="false"
                            android:textColor="#1A0B33"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/select_server_button"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/home_server_select_button"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0"
                            android:text="تغيير السيرفر"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="10.5sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/home_next_step_button"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/home_server_select_button"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:text="الخطوة التالية"
                        android:textColor="@android:color/white"
                        android:textSize="9.5sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Right column: logo + realistic name + quick access -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:contentDescription="Arab Island"
                        android:scaleType="fitCenter"
                        android:src="@drawable/arab_island_logo" />

                    <LinearLayout
                        android:id="@+id/home_name_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/home_panel_surface"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="الاسم الواقعي"
                            android:textColor="@color/launcher_accent_gold_bright"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/home_name_value"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/launcher_field_surface_dark"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center_vertical|start"
                            android:layoutDirection="ltr"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Steve_Max"
                            android:textColor="@color/launcher_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="الصيغة: الاسم_العائلة مثل Steve_Max • اضغط للتعديل"
                            android:textColor="@color/launcher_text_muted"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/home_quick_settings"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_stat_tile"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="الإعدادات"
                                android:textColor="@android:color/white"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_quick_host"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_stat_tile"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="هوست"
                                android:textColor="@color/launcher_success"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_quick_files"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_stat_tile"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="الملفات"
                                android:textColor="@color/launcher_accent_blue"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
